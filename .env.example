# LoRA-JIT environment configuration
# Copy to .env and adjust for your machine:
#   cp .env.example .env

# ── Runtime backend ──────────────────────────────────────────────────────────
# mock  = deterministic stubs, no GPU (default, CI-friendly)
# pytorch = real PEFT adapter hot-swap and token generation
LORA_JIT_RUNTIME_BACKEND=mock

# HuggingFace base model (used when runtime=pytorch)
LORA_JIT_BASE_MODEL_ID=Qwen/Qwen1.5-0.5B

# Directory containing one subdirectory per adapter ID
LORA_JIT_ADAPTER_DIR=adapters

# cpu | cuda | auto
LORA_JIT_DEVICE=cpu

# Load base model at daemon boot (faster first route, higher RAM/VRAM at idle)
LORA_JIT_EAGER_LOAD=false

# Comma-separated adapter IDs to warm at startup (eliminates cold-miss on first route)
# Example: sql_postgres,fastapi_service
LORA_JIT_PRELOAD_ADAPTERS=

# When true, /jit/complete failures return HTTP 500 instead of silent stub fallback
LORA_JIT_STRICT_RUNTIME=false

# ── Paging simulator ─────────────────────────────────────────────────────────
LORA_JIT_MAX_HOT_ADAPTERS=3
# Optional approximate MB budget for LRU evictions (leave empty for count-only)
LORA_JIT_MAX_HOT_MB=

# ── Router / predictor ─────────────────────────────────────────────────────────
# structural | text | embedding | learned
LORA_JIT_PREDICTOR=structural

# Path to trained Naive Bayes router artifact (required when predictor=learned)
LORA_JIT_ROUTER_MODEL_PATH=examples/router-model.seed.json

# ── Offline labeling (optional) ───────────────────────────────────────────────
# OpenAI-compatible endpoint for LLM-assisted benchmark annotation
LORA_JIT_LLM_API_BASE=
LORA_JIT_LLM_API_KEY=
